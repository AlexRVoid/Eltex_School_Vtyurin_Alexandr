    if read -r line < "$FIFO"; then        #   "NAME[PID]: how much time do I have?"        if [[ "$line" =~ ^(.*)\[([0-9]+)\]:\ how\ much\ time\ do\ I\ have\?$ ]]; then            NAME="${BASH_REMATCH[1]}"            PID="${BASH_REMATCH[2]}"                        #   N  2  10            N=$(( RANDOM % 9 + 2 ))                        #                   echo "$N" > "$FIFO"                        #              echo "$(date '+%Y-%m-%d %H:%M:%S') ${NAME}[${PID}] ${N}" >> "$LOGFILE"        fi    fidoneEOFchmod +x /root/practice3/cuckoo.sh
