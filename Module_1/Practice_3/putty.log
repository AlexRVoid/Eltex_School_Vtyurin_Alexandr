#!/bin/bash

LOGFILE="$(pwd)/cuckoo.log"
FIFO=""

# 1.    --pishitesuda=
for arg in "$@"; do
    case "$arg" in
        --pishitesuda=*)
            FIFO="${arg#*=}"
            ;;
    esac
done

if [[ -z "$FIFO" ]]; then
    echo ":     --pishitesuda=//" >&2
    exit 1
fi

# 2.   (SIGTERM  SIGINT)
cleanup() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') Shutdown!" >> "$LOGFILE"
    rm -f "$FIFO"
    exit 0
}
trap cleanup SIGTERM SIGINT

# 3.   
[[ -p "$FIFO" ]] || mkfifo "$FIFO"

# 4.  
echo "$(date '+%Y-%m-%d %H:%M:%S') Startup!" >> "$LOGFILE"

# 5.     FIFO
while true; do
    if read -r line < "$FIFO"; then        #   "NAME[PID]: how much time do I have?"        if [[ "$line" =~ ^(.*)\[([0-9]+)\]:\ how\ much\ time\ do\ I\ have\?$ ]]; then            NAME="${BASH_REMATCH[1]}"            PID="${BASH_REMATCH[2]}"                        #   N  2  10            N=$(( RANDOM % 9 + 2 ))                        #                   echo "$N" > "$FIFO"                        #              echo "$(date '+%Y-%m-%d %H:%M:%S') ${NAME}[${PID}] ${N}" >> "$LOGFILE"        fi    fidoneEOFchmod +x /root/practice3/cuckoo.sh# 2.   (SIGTERM  SIGINT)
cleanup() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') Shutdown!" >> "$LOGFILE"
    rm -f "$FIFO"
    exit 0
}
trap cleanup SIGTERM SIGINT

# 3.   
[[ -p "$FIFO" ]] || mkfifo "$FIFO"

# 4.  
